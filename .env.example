# =========================================================
# 果壁 Studio (AppleWall Studio) 环境变量配置
# 默认不填任何 Key 即可使用内置「本地即时增强引擎」体验完整流程
# 配置以下任意一家国内/海外 AI API Key 后，自动启用云端 AI 生成
# =========================================================

# 可选值: local | volcengine | dashscope | siliconflow | gemini
AI_PROVIDER=local

# 1. 火山引擎方舟 (推荐国内：豆包 SeedEdit 3.0 强原图一致性 + Seedream 风景艺术)
VOLC_API_KEY=
VOLC_ENDPOINT_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLC_EDIT_MODEL=doubao-seededit-3-0-i2i-250628
VOLC_ART_MODEL=doubao-seedream-3-0-t2i-250415

# 2. 阿里云百炼 DashScope (通义万相 Wanx 图像编辑/风格化)
DASHSCOPE_API_KEY=

# 3. 硅基流动 SiliconFlow (支持 FLUX Kontext / Kolors 等开源强模型)
SILICONFLOW_API_KEY=

# 4. Google Gemini Image (可选海外模型)
GEMINI_API_KEY=

# 数据库与对象存储 (生产环境启用，MVP 本地运行无需配置)
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=applewall-media
R2_PUBLIC_URL=

# 免费模式防刷限流配置
DAILY_FREE_LIMIT_PER_IP=15
